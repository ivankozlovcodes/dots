# Every boxed claude process lives here (claude-hc and its via connections).
# claude-egress.nft lets claude reach a loopback socket only if that socket's cgroup is
# under this slice, so the slice is kept active (stable cgroup id for nft).
[Unit]
Description=sandboxed claude sessions
Before=slices.target

[Install]
WantedBy=multi-user.target
