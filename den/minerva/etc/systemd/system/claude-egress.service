[Unit]
Description=nftables: claude egress policy (internet, SearXNG, own loopback sockets only)
Requires=claude.slice
After=claude.slice
Before=claude-herdr.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/claude-egress.nft
ExecStop=/usr/sbin/nft destroy table inet claude_egress

[Install]
WantedBy=multi-user.target
