# Collie (herdr phone client) on minerva
COLLIE_MUX=herdr
# :8787 is taken by obsidian-redirect; the tailnet :443 root is already served, so use our own ports
COLLIE_PORT=8801
COLLIE_HOST=127.0.0.1
COLLIE_SERVE_PORT=8443
# only this tailnet login may use it
COLLIE_TRUSTED_USER=ivaan.kozlov@gmail.com
COLLIE_TELEMETRY=0
