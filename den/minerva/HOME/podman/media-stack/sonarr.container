[Unit]
Description=Sonarr
After=network-online.target
RequiresMountsFor=/mnt/nas
# RequiresMountsFor is inert here: mnt-nas.mount is a system unit and this
# runs under the user manager. /mnt/nas is an x-systemd.automount over CIFS
# to casa.den, so a cold boot can leave it unresolvable for a minute or two.
# The backoff and burst below are sized to outlast that without masking a
# genuine crash loop.
StartLimitIntervalSec=1800
StartLimitBurst=10

[Container]
ContainerName=sonarr
Image=ghcr.io/hotio/sonarr:latest
AutoUpdate=registry
Network=media.network
PublishPort=7877:8989
Environment=PUID=0
Environment=PGID=0
Environment=TZ=America/Los_Angeles
Volume=/etc/localtime:/etc/localtime:ro
Volume=/home/minerva/appdata/servarr/sonarr:/config
Volume=/home/minerva/torrents:/data/torrents
Volume=/mnt/nas/media:/data/media


[Service]
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
