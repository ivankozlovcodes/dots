[Unit]
Description=OpenViking context database server

[Container]
ContainerName=openviking
# Pinned to the v0.5.5 release (GitHub tag and GHCR tag); bump deliberately, never latest.
Image=ghcr.io/volcengine/openviking:v0.5.5
Pod=openviking.pod
# Runtime data (vectors, AGFS, sessions) in appdata. ov.conf is bind-mounted read-only from this dir.
Volume=/home/minerva/appdata/openviking:/app/.openviking
Volume=/home/minerva/git/dots/den/minerva/HOME/podman/openviking/ov.conf:/app/.openviking/ov.conf:ro
# Root key for account administration only; `${OPENVIKING_ROOT_API_KEY}` in ov.conf expands from it.
# Create with: openssl rand -hex 32 | podman secret create openviking_root_key -
Secret=openviking_root_key,type=env,target=OPENVIKING_ROOT_API_KEY
# Skip the VikingBot gateway; the server alone is enough for the Studio UI, REST API, and MCP.
Environment=OPENVIKING_WITH_BOT=0
Environment=TZ=America/Los_Angeles
HealthCmd=openviking-entrypoint --healthcheck
HealthStartPeriod=60s
HealthTimeout=5s
HealthInterval=30s
HealthRetries=3

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
