[Unit]
Description=Infradeck agent worker (runs incident-agent jobs from Redis)
After=network-online.target infradeck-backend.service
Wants=infradeck-backend.service

[Container]
ContainerName=infradeck-agent-worker
# Same image as the backend (see infradeck-backend.container for the build command).
Image=localhost/infradeck-backend:1.0.0-local
Pull=never
Exec=python -m src.agent.worker
Network=infradeck-data.network
# front is not Internal, so the worker can reach the model provider (upstream compose does the same).
Network=infradeck-front.network
# Publishes alerts to ntfy as http://ntfy/infradeck (see podman/ntfy).
Network=ntfy.network
Secret=infradeck_database_url,type=env,target=DATABASE_URL
Secret=infradeck_redis_url,type=env,target=REDIS_URL
# Decrypts the agent's API key stored by Admin › Incident agent.
Secret=infradeck_secrets_key,type=env,target=SECRETS_KEY
Environment=PYTHONDONTWRITEBYTECODE=1
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
