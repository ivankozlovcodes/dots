[Unit]
Description=Immich Server
Requires=immich-redis.container immich-database.container

[Container]
#AutoUpdate=registry
Pod=immich.pod
Image=ghcr.io/immich-app/immich-server:v3
Volume=/mnt/nas/photos:/data:z
Volume=/etc/localtime:/etc/localtime:ro
Environment=TZ=America/Los_Angeles
Secret=immich_postgress_db_pass,type=env,target=DB_PASSWORD
Environment=DB_USERNAME=postgres
Environment=DB_DATABASE_NAME=immich
Environment=DB_HOSTNAME=localhost
Environment=REDIS_HOSTNAME=localhost
#AddDevice=/dev/dri

[Service]
TimeoutStartSec=900
