#!/usr/bin/env python3
"""Publish EMC2101 readings as a sysfs-shaped hwmon tree.

Userspace cannot create nodes under /sys — only a kernel driver can register a
hwmon device — so this mirrors the same file names and units into a normal
directory. Point a reader at it with SYS_SENSORS=/run/emc2101-hwmon/sys.

Real hwmon chips are symlinked in, because SYS_SENSORS replaces the sensor path
outright and a bare tree would hide the host's own sensors.

Read-only with respect to the chip. Fan control belongs to emc2101-fanctl; this
process must never write a register.
"""

import glob
import os
import time

import board
from adafruit_emc2101 import EMC2101

POLL_SECONDS = 10
SYSFS_ROOT = "/run/emc2101-hwmon/sys"
FAKE_CHIP = "hwmon99"  # must match a reader's hwmon* glob

# The EMC2101 derives RPM as 5_400_000 / tach_count across two registers. A read
# that straddles an update returns a mangled count, which shows up as absurd RPM.
TACH_MIN_RPM = 100
TACH_MAX_RPM = 4000


def write_atomic(path, value):
    """Write a sysfs-style value without ever exposing a half-written file."""
    tmp = f"{path}.tmp"
    with open(tmp, "w") as handle:
        handle.write(f"{value}\n")
    os.replace(tmp, path)


def init_tree():
    """Build the tree and return the fake chip's directory."""
    hwmon_dir = os.path.join(SYSFS_ROOT, "class", "hwmon")
    os.makedirs(hwmon_dir, exist_ok=True)

    for entry in glob.glob("/sys/class/hwmon/hwmon*"):
        link = os.path.join(hwmon_dir, os.path.basename(entry))
        if not os.path.lexists(link):
            os.symlink(os.path.realpath(entry), link)

    for relative, target in (
        ("class/thermal", "/sys/class/thermal"),
        ("devices/virtual/thermal", "/sys/devices/virtual/thermal"),
    ):
        link = os.path.join(SYSFS_ROOT, relative)
        os.makedirs(os.path.dirname(link), exist_ok=True)
        if not os.path.lexists(link) and os.path.exists(target):
            os.symlink(target, link)

    chip = os.path.join(hwmon_dir, FAKE_CHIP)
    os.makedirs(chip, exist_ok=True)
    write_atomic(os.path.join(chip, "name"), "emc2101")
    write_atomic(os.path.join(chip, "temp1_label"), "emc2101 internal")
    write_atomic(os.path.join(chip, "fan1_label"), "rack fans")
    return chip


def read_tach(emc):
    """Return RPM, or None if both attempts come back implausible."""
    for _ in range(2):
        try:
            rpm = emc.fan_speed
        except OSError:
            return None
        if TACH_MIN_RPM <= rpm <= TACH_MAX_RPM:
            return rpm
        time.sleep(0.2)
    return None


def main():
    chip = init_tree()
    emc = EMC2101(board.I2C())
    print(f"start: publishing to {chip} every {POLL_SECONDS}s", flush=True)

    while True:
        rpm = read_tach(emc)
        if rpm is not None:
            write_atomic(os.path.join(chip, "fan1_input"), round(rpm))

        try:
            write_atomic(
                os.path.join(chip, "temp1_input"),
                round(emc.internal_temperature * 1000),
            )
        except OSError:
            pass  # transient bus error; keep the previous value rather than lying

        try:
            # Reading the fan setting register reports whatever emc2101-fanctl
            # last wrote, without this process touching the chip's state.
            write_atomic(
                os.path.join(chip, "pwm1"),
                round(emc.manual_fan_speed * 255 / 100),
            )
        except OSError:
            pass

        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
